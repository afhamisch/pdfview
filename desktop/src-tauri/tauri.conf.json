{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFView",
  "version": "0.1.0",
  "identifier": "com.napleslitigation.pdfview",
  "build": {
    "frontendDist": "../../app/dist-offline"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "PDFView", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 600, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF document", "description": "PDF document", "mimeType": "application/pdf", "role": "Editor" }
    ],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
