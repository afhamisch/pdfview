{
  "name": "pdfview",
  "private": true,
  "version": "0.1.0",
  "description": "PDFView: offline PDF viewer and editor with an envelope-based e-signature service",
  "workspaces": [
    "app",
    "server",
    "desktop"
  ],
  "scripts": {
    "dev": "npm --workspace app run dev",
    "build": "npm --workspace app run build",
    "build:offline": "npm --workspace app run build:offline",
    "start": "npm --workspace server start",
    "test": "npm --workspace server test && npm --workspace app test",
    "desktop:build": "npm --workspace desktop run build",
    "build:desktop": "npm --workspace app run build:desktop"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/crimson-pro": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "tesseract.js": "^7.0.0"
  }
}
